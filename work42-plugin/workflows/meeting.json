{
  "slug": "meeting",
  "name": "Meeting",
  "description": "The meeting lifecycle: Prepare for Meeting, In Meeting, Summary, Done -- driven by the recording lifecycle of the meet42 command-line tool (github.com/Work42-Ai/meet42). meet42 reads the calendar, records and transcribes the meeting, and writes the files this workflow reads; every stage assumes it is installed. If `command -v meet42` prints nothing, ask the user, and with their yes the `meet42-setup` skill installs it.",
  "stages": [
    {
      "name": "Prepare for Meeting",
      "ordinal": 1,
      "is_initial": true,
      "is_terminal": false,
      "entry_prompt": "You're in Prepare for Meeting. This meeting runs on the meet42 command-line tool: first run `command -v meet42`. If it prints nothing (or a meet42 command fails because the tool is missing), ask the user whether they want you to install it (never install it without their yes), and if they agree follow the `meet42-setup` skill to install it and grant its permissions before anything else. Then fetch the context this meeting needs -- attendees, recent related threads, open tasks (`meet42 show <event_id>` gives the freshest event details, `meet42 people` the people it knows) -- so it's ready before the meeting starts. Starting the recording writes meeting/started_at, which moves this session to In Meeting.",
      "entry_gate": null,
      "icon": "tray.and.arrow.down",
      "color_light": "#0284C7",
      "color_dark": "#66C8FF",
      "model": "sonnet",
      "provider": "claude"
    },
    {
      "name": "In Meeting",
      "ordinal": 2,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "The recording started -- you're now In Meeting, running on Haiku for fast live notes. meet42 is doing the recording (`meet42 record status` shows it) and writing the live transcript to conversation.jsonl in the recording directory stored at meeting/recording_dir. If a meet42 command fails because the tool is missing or too old, ask the user whether to install or update it, and follow the `meet42-setup` skill only if they agree. The user types their own notes into annotations.md in your session directory while the meeting runs; read it as you go and treat it as the priority signal. Keep concise running notes as the conversation happens. Stopping the recording writes meeting/ended_at, which moves this session to Summary.",
      "entry_gate": "{\"and\":[{\"namespace\":\"meeting\",\"key\":\"started_at\",\"op\":\"exists\"},{\"namespace\":\"meeting\",\"key\":\"ended_at\",\"op\":\"absent\"}]}",
      "icon": "waveform",
      "color_light": "#6D28D9",
      "color_dark": "#9D6BFF",
      "model": "haiku",
      "provider": "claude"
    },
    {
      "name": "Summary",
      "ordinal": 3,
      "is_initial": false,
      "is_terminal": false,
      "entry_prompt": "The recording stopped -- you're now in Summary, and this is the most important step: build the best possible summary of the meeting. Read everything it produced, in this order. (1) The user's own notes: annotations.md in your session directory (your working directory). They show what the user thought mattered, so anchor the summary on them. (2) The event details: meeting.json in your session directory (title, time, attendees, location) -- skip it if there is none. (3) The transcript meet42 wrote: conversation.jsonl in the recording directory, whose path is `work42 storage get meeting/recording_dir`. Each line is a JSON object with speaker (\"You\" is the user, \"Them\" the other side, or a name), text and audioStartSeconds; read all of it before writing. Use the transcript to fill in context, decisions and exact wording behind each note, and to catch important points the notes missed. Never invent anything that is in neither source; say so plainly when something is unclear or missing. Write the summary as markdown to summary.md in your session directory (the Summary tab renders that file) with these sections: a one-paragraph overview, Decisions, Action items (owner and due date when stated), Open questions, and Key points from the user's notes. Then run `work42 storage set meeting/summary '\"summary.md\"'` and `work42 transition \"Done\"`.",
      "entry_gate": "{\"namespace\": \"meeting\", \"key\": \"ended_at\", \"op\": \"exists\"}",
      "icon": "doc.text",
      "color_light": "#B45309",
      "color_dark": "#FFC766",
      "model": "sonnet",
      "provider": "claude"
    },
    {
      "name": "Done",
      "ordinal": 4,
      "is_initial": false,
      "is_terminal": true,
      "entry_prompt": "The recap is written -- this meeting is Done. No further action needed.",
      "entry_gate": "{\"namespace\": \"meeting\", \"key\": \"summary\", \"op\": \"exists\"}",
      "icon": "checkmark.circle.fill",
      "color_light": "#15803D",
      "color_dark": "#4CDB73",
      "model": "sonnet",
      "provider": "claude"
    }
  ],
  "transitions": [
    {
      "from": "Prepare for Meeting",
      "to": "In Meeting",
      "description": "the recording is active (meeting/started_at written and meeting/ended_at absent)"
    },
    {
      "from": "Prepare for Meeting",
      "to": "Summary",
      "description": "the recording finished before the preparation turn transitioned (meeting/ended_at written)"
    },
    {
      "from": "In Meeting",
      "to": "Summary",
      "description": "the recording stopped (meeting/ended_at written)"
    },
    {
      "from": "Summary",
      "to": "Done",
      "description": "the recap is written (meeting/summary written)"
    },
    {
      "from": "In Meeting",
      "to": "Prepare for Meeting",
      "description": "back out to prep (recording reset)"
    },
    {
      "from": "Summary",
      "to": "Prepare for Meeting",
      "description": "back out to prep (recording reset)"
    }
  ],
