<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  meet42.entitlements — signed into the release binary (scripts/release.sh, scripts/build-meet42.sh).

  None. The release is built with the Hardened Runtime (notarization requires it), and meet42 needs no exception to it: since
  2.0.0 Work42 holds the microphone, system-audio, calendar and speech permissions and does that work for the meet42
  plugin, so meet42 has no audio-input or calendar entitlement. No sandbox.
-->
<plist version="1.0">
<dict/>
</plist>
