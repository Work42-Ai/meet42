<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  meet42-Info.plist — the Info.plist of meet42.app (scripts/build-meet42.sh), and also embedded into the
  binary's __TEXT,__info_plist section so a bare `swift build` binary carries the same identity.
  meet42 ships as a small signed app bundle (no Dock icon, no window) so Work42 can keep it at ~/.work42/meet42.app and link
  `meet42` from ~/.work42/bin. Since 2.0.0 it holds no privacy permission: Work42 records, transcribes and reads the
  calendars for the meet42 plugin, so there are no usage-description strings here.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.work42.meet42</string>
    <key>CFBundleName</key>
    <string>meet42</string>
    <key>CFBundleDisplayName</key>
    <string>meet42</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>CFBundleExecutable</key>
    <string>meet42</string>
</dict>
</plist>
