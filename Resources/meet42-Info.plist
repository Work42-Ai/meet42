<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  meet42-Info.plist — the Info.plist of meet42.app (scripts/build-meet42.sh), and also embedded into the
  binary's __TEXT,__info_plist section so a bare `swift build` binary carries the same usage strings.
  meet42 ships as a small signed app bundle (no Dock icon, no window) because macOS only shows its
  permission prompts reliably for an app bundle, not for a bare command-line binary.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.work42.meet42</string>
    <key>CFBundleName</key>
    <string>meet42</string>
    <key>CFBundleDisplayName</key>
    <string>meet42</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>CFBundleExecutable</key>
    <string>meet42</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>meet42 reads your calendar to list meetings and prepare sessions for them.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>meet42 records meeting audio locally to produce a private transcript.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>meet42 listens to your Mac's audio output during a meeting so it can transcribe the other participants. It never records your screen.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>meet42 transcribes meeting audio on-device using the system speech recognizer.</string>
</dict>
</plist>
